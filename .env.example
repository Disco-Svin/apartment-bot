# Скопируйте этот файл в .env и заполните своими значениями.
# Токен бота получаете у @BotFather в Telegram (команда /newbot).
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ID чатов, куда слать уведомления — через запятую, если получателей
# несколько. Каждый должен сначала написать боту /start, иначе бот не
# сможет писать ему первым. Узнать свой ID — у бота @userinfobot.
TELEGRAM_CHAT_IDS=123456789,987654321
